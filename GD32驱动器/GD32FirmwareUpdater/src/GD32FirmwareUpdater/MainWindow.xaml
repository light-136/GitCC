<Window x:Class="GD32FirmwareUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GD32FirmwareUpdater.ViewModels"
        xmlns:cvt="clr-namespace:GD32FirmwareUpdater.Converters"
        mc:Ignorable="d"
        Title="GD32 低压驱动器固件升级工具 v1.0"
        Height="720" Width="960"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <cvt:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <cvt:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 标题栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 主内容区 -->
            <RowDefinition Height="*"/>
            <!-- 状态栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 标题栏 ==================== -->
        <Border Grid.Row="0" Background="#1565C0" CornerRadius="6" Padding="16,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="GD32 低压驱动器固件升级工具"
                           FontSize="18" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bootloader版本: " Foreground="#B3E5FC" FontSize="12"/>
                    <TextBlock Text="{Binding BootloaderVersion}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主内容区 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 左侧：配置和控制区 -->
                <ColumnDefinition Width="320"/>
                <!-- 右侧：日志区 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧面板 ===== -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">

                <!-- 串口配置区 -->
                <GroupBox Header="串口配置" BorderBrush="#E0E0E0" Margin="0,0,0,8">
                    <StackPanel Margin="4">
                        <!-- COM端口选择 -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="端口:" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailablePorts}"
                                      SelectedItem="{Binding SelectedPort}"
                                      IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>
                            <Button Grid.Column="2" Content="刷新" Margin="4,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="10,4"
                                    Command="{Binding RefreshPortsCommand}"
                                    IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>

                        <!-- 波特率 -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="波特率:" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding BaudRateOptions}"
                                      SelectedItem="{Binding SelectedBaudRate}"
                                      IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>

                        <!-- 数据位 -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="数据位:" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding DataBitsOptions}"
                                      SelectedItem="{Binding SelectedDataBits}"
                                      IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>

                        <!-- 停止位 -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="停止位:" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding StopBitsOptions}"
                                      SelectedItem="{Binding SelectedStopBits}"
                                      IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>

                        <!-- 校验位 -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="校验位:" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ParityOptions}"
                                      SelectedItem="{Binding SelectedParity}"
                                      IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>

                        <!-- 连接按钮 + 状态指示 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 连接状态指示灯 -->
                            <Ellipse Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0"
                                     Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                                       Text="{Binding IsConnected, StringFormat={}{0}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="未连接"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="已连接"/>
                                                <Setter Property="Foreground" Value="#2ECC71"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2"
                                    Content="{Binding ConnectButtonText}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="20,6"
                                    Command="{Binding ToggleConnectCommand}"
                                    IsEnabled="{Binding IsUpgrading, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 固件文件选择区 -->
                <GroupBox Header="固件文件" BorderBrush="#E0E0E0" Margin="0,0,0,8">
                    <StackPanel Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding FirmwareFilePath}"
                                     IsReadOnly="True" VerticalContentAlignment="Center"
                                     Height="28" FontSize="11"
                                     ToolTip="{Binding FirmwareFilePath}"/>
                            <Button Grid.Column="1" Content="浏览..."
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="12,4" Margin="4,0,0,0"
                                    Command="{Binding SelectFirmwareCommand}"
                                    IsEnabled="{Binding IsUpgrading, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#757575">
                            <Run Text="文件大小: "/>
                            <Run Text="{Binding FirmwareFileSize, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- 操作控制区 -->
                <GroupBox Header="操作控制" BorderBrush="#E0E0E0" Margin="0,0,0,8">
                    <StackPanel Margin="4">
                        <!-- 开始升级 / 取消升级 按钮 -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="开始烧录"
                                    Style="{StaticResource SuccessButton}"
                                    Margin="0,0,4,0" Height="38"
                                    Command="{Binding StartUpgradeCommand}"
                                    IsEnabled="{Binding IsUpgrading, Converter={StaticResource InverseBoolConverter}}"/>
                            <Button Grid.Column="1" Content="取消烧录"
                                    Style="{StaticResource DangerButton}"
                                    Margin="4,0,0,0" Height="38"
                                    Command="{Binding CancelUpgradeCommand}"
                                    IsEnabled="{Binding IsUpgrading}"/>
                        </Grid>

                        <!-- 查询版本号按钮 -->
                        <Button Content="查询版本号" Margin="0,8,0,0"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch" Height="34"
                                Command="{Binding QueryVersionCommand}"
                                IsEnabled="{Binding IsUpgrading, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </GroupBox>

                <!-- 升级进度区 -->
                <GroupBox Header="升级进度" BorderBrush="#E0E0E0">
                    <StackPanel Margin="4">
                        <ProgressBar Height="22" Minimum="0" Maximum="100"
                                     Value="{Binding UpgradeProgress}"
                                     Foreground="#4CAF50"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="14" FontWeight="Bold"
                                       Foreground="#1565C0">
                                <Run Text="{Binding UpgradeProgress, Mode=OneWay}"/>
                                <Run Text="%"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                                       FontSize="11" Foreground="#757575"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- ===== 右侧日志区 ===== -->
            <GroupBox Grid.Column="1" Header="通讯日志" BorderBrush="#E0E0E0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 日志列表 -->
                    <ListBox Grid.Row="0" x:Name="LogListBox"
                             ItemsSource="{Binding LogMessages}"
                             Background="#1E1E1E" Foreground="#D4D4D4"
                             FontFamily="Consolas, 微软雅黑" FontSize="11"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="NoWrap" Padding="2,1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Converter={x:Static cvt:LogColorHelper.Instance}}" Value="TX">
                                                    <Setter Property="Foreground" Value="#569CD6"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Converter={x:Static cvt:LogColorHelper.Instance}}" Value="RX">
                                                    <Setter Property="Foreground" Value="#4EC9B0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Converter={x:Static cvt:LogColorHelper.Instance}}" Value="ERROR">
                                                    <Setter Property="Foreground" Value="#F44747"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Converter={x:Static cvt:LogColorHelper.Instance}}" Value="SUCCESS">
                                                    <Setter Property="Foreground" Value="#6A9955"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 清空按钮 -->
                    <Button Grid.Row="1" Content="清空日志"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            Margin="0,6,0,0" Padding="16,4"
                            Command="{Binding ClearLogCommand}"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="2" Background="#E0E0E0" CornerRadius="4" Padding="12,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           FontSize="12" Foreground="#616161"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" FontSize="11" Foreground="#9E9E9E"
                           Text="苏州元磁智控 | GD32 Firmware Updater v1.0"/>
            </Grid>
        </Border>
    </Grid>
</Window>

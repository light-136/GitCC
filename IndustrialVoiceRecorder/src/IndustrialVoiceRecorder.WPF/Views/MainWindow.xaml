<Window x:Class="IndustrialVoiceRecorder.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工业语音记录系统 v3.0"
        Height="850" Width="1300"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1976D2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#BDBDBD"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F44336"/>
        </Style>
        <Style TargetType="Button" x:Key="SuccessButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#4CAF50"/>
        </Style>
        <Style TargetType="Button" x:Key="SmallButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 第1行：设备+操作员+日期 ===== -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <Border.Effect><DropShadowEffect ShadowDepth="1" Opacity="0.08" BlurRadius="4"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="工业语音记录系统" FontSize="16" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="设备:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#666" FontSize="12"/>
                    <ComboBox Width="220" Height="28" FontSize="12" ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name"/>
                    <Button Content="刷新" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource SmallButton}" Margin="5,0,0,0"/>
                    <Ellipse Width="8" Height="8" Margin="10,0,3,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse"><Setter Property="Fill" Value="#BDBDBD"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsDeviceConnected}" Value="True"><Setter Property="Fill" Value="#4CAF50"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="操作员:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="12" Foreground="#666" FontWeight="Bold"/>
                    <ComboBox Width="130" Height="28" FontSize="12" ItemsSource="{Binding OperatorList}" SelectedItem="{Binding SelectedOperator}" DisplayMemberPath="DisplayName"/>
                    <Button Content="管理" Command="{Binding ManageOperatorsCommand}" Style="{StaticResource SmallButton}" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="日期:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="12" Foreground="#666"/>
                    <DatePicker Width="120" Height="28" FontSize="12" SelectedDate="{Binding FilterDate}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 第2行：操作按钮 + 实时识别 ===== -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <Border.Effect><DropShadowEffect ShadowDepth="1" Opacity="0.08" BlurRadius="4"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding ToggleRecordingCommand}" Padding="25,8" FontSize="14">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="🎙 开始录音"/><Setter Property="Background" Value="#4CAF50"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Content" Value="⏹ 停止录音"/><Setter Property="Background" Value="#F44336"/>
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="📊 导出" Command="{Binding ExportExcelCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="🔄 刷新" Command="{Binding LoadRecordsByDateCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="⏹ 停止播放" Command="{Binding StopAudioCommand}" Style="{StaticResource DangerButton}"/>
                    <!-- 复核登录/登出 -->
                    <Button Content="{Binding ReviewButtonText}" Command="{Binding ToggleReviewModeCommand}"
                           Padding="15,8" FontSize="13" Margin="10,3,3,3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Background" Value="#FF9800"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReviewMode}" Value="True">
                                        <Setter Property="Background" Value="#E65100"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <Border Grid.Column="1" Background="#E3F2FD" CornerRadius="4" Padding="10,6" Margin="10,0" MinHeight="36">
                    <TextBlock Text="{Binding RealtimeText}" FontSize="15" TextWrapping="Wrap" Foreground="#1565C0" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,4,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse"><Setter Property="Fill" Value="#BDBDBD"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Fill" Value="#F44336"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="12" Foreground="#666" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"><Setter Property="Text" Value="未录音"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Text" Value="录音中"/><Setter Property="Foreground" Value="#F44336"/>
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 第3行：记录列表（可直接编辑） ===== -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <Border.Effect><DropShadowEffect ShadowDepth="1" Opacity="0.08" BlurRadius="4"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontSize="12" FontWeight="Bold" Foreground="#333" Margin="4,2,4,6">
                    <Run Text="📋 检测记录 - "/><Run Text="{Binding FilterDate, StringFormat=yyyy-MM-dd}" Foreground="#1565C0"/>
                    <Run Text=" ("/><Run Text="{Binding TodayTotal}"/><Run Text="条)"/>
                    <Run Text="  双击可直接编辑，修改后自动弹出复核人登录" Foreground="#999" FontWeight="Normal" FontSize="11"/>
                </TextBlock>

                <DataGrid Grid.Row="1" x:Name="RecordsGrid"
                         ItemsSource="{Binding Records}"
                         SelectedItem="{Binding SelectedRecord}"
                         AutoGenerateColumns="False"
                         CanUserSortColumns="True"
                         CanUserAddRows="False"
                         SelectionMode="Single"
                         AlternatingRowBackground="#FAFAFA"
                         GridLinesVisibility="Horizontal"
                         HorizontalGridLinesBrush="#E0E0E0"
                         BorderThickness="0"
                         FontSize="12"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         CellEditEnding="DataGrid_CellEditEnding"
                         BeginningEdit="DataGrid_BeginningEdit">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="Foreground" Value="#1565C0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- 序号（只读） -->
                        <DataGridTextColumn Header="序号" Binding="{Binding SerialNumber}" Width="130" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#6A1B9A"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- 时间（只读） -->
                        <DataGridTextColumn Header="时间" Binding="{Binding RecordTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="135" IsReadOnly="True"/>
                        <!-- 识别原文（只读） -->
                        <DataGridTextColumn Header="识别原文" Binding="{Binding RecognizedText}" Width="*" MinWidth="120" IsReadOnly="True"/>
                        <!-- 数字化文本（可编辑） -->
                        <DataGridTextColumn Header="数字化文本" Binding="{Binding NormalizedText}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#0D47A1"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- 产品号（只读） -->
                        <DataGridTextColumn Header="产品号" Binding="{Binding ProductId}" Width="55" IsReadOnly="True"/>
                        <!-- 状态（可编辑下拉） -->
                        <DataGridComboBoxColumn Header="状态" SelectedItemBinding="{Binding Status}" Width="60">
                            <DataGridComboBoxColumn.ItemsSource>
                                <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                    <sys:String>OK</sys:String>
                                    <sys:String>NG</sys:String>
                                </x:Array>
                            </DataGridComboBoxColumn.ItemsSource>
                        </DataGridComboBoxColumn>
                        <!-- 操作员（只读） -->
                        <DataGridTextColumn Header="操作员" Binding="{Binding Operator}" Width="75" IsReadOnly="True"/>
                        <!-- 备注（可编辑） -->
                        <DataGridTextColumn Header="备注" Binding="{Binding Remarks}" Width="80"/>
                        <!-- 复核人（只读） -->
                        <DataGridTextColumn Header="复核人" Binding="{Binding CorrectedBy}" Width="65" IsReadOnly="True"/>
                        <!-- 播放按钮 -->
                        <DataGridTemplateColumn Header="音频" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="▶" FontSize="14" Cursor="Hand"
                                           Command="{Binding DataContext.PlayAudioCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           Background="Transparent" BorderThickness="0" Foreground="#1565C0"
                                           ToolTip="播放原始音频"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ===== 第4行：统计栏 ===== -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <Border.Effect><DropShadowEffect ShadowDepth="1" Opacity="0.08" BlurRadius="4"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="总数" FontSize="11" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TodayTotal}" FontSize="24" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="合格" FontSize="11" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TodayOkCount}" FontSize="24" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="不合格" FontSize="11" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TodayNgCount}" FontSize="24" FontWeight="Bold" Foreground="#F44336" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="合格率" FontSize="11" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TodayPassRate}" FontSize="24" FontWeight="Bold" Foreground="#FF9800" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 第5行：状态栏 ===== -->
        <Border Grid.Row="4" Background="#E3F2FD" CornerRadius="4" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Center">
                    <Run Text="操作员: " Foreground="#666"/><Run Text="{Binding SelectedOperator.DisplayName}" Foreground="#1565C0" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="v3.0 | FunASR" FontSize="10" Foreground="#999" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
